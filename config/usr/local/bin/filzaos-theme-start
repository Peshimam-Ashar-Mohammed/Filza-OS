#!/bin/bash

sleep 2

gsettings set org.gnome.desktop.background picture-uri \
"file:///usr/share/backgrounds/filzaos/filzaos.png"

gsettings set org.gnome.desktop.background picture-uri-dark \
"file:///usr/share/backgrounds/filzaos/filzaos.png"

gsettings set org.gnome.desktop.background picture-options "zoom"

gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"

gsettings set org.gnome.desktop.interface accent-color "purple" 2>/dev/null || true

gsettings set org.gnome.desktop.interface icon-theme "FilzaOS"

gsettings set org.gnome.desktop.interface gtk-theme "FilzaOS"
