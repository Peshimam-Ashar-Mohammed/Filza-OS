#!/usr/bin/env bash
# ============================================================
# FILZAOS SYSTEM INFO
# ============================================================

PURPLE='\033[38;5;141m'
LAVENDER='\033[38;5;183m'
RESET='\033[0m'
BOLD='\033[1m'

KERNEL=$(uname -r)
ARCH=$(uname -m)
HOST=$(hostname)
USER_NAME=${USER:-$(whoami)}
SHELL_NAME=$(basename "${SHELL:-bash}")
DESKTOP="GNOME 46"

CPU=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[ \t]*//' || echo "Unknown")
GPU=$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | cut -d: -f3 | sed 's/^[ \t]*//' | head -1 || echo "Standard VGA / Virtual")
[[ -z "$GPU" ]] && GPU="Virtual Display Controller"

MEM_TOTAL=$(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')
MEM_USED=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3}')

DISK_TOTAL=$(df -h / 2>/dev/null | awk 'NR==2 {print $2}')
DISK_USED=$(df -h / 2>/dev/null | awk 'NR==2 {print $3}')
DISK_PERCENT=$(df -h / 2>/dev/null | awk 'NR==2 {print $5}')

UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || uptime | awk '{print $3}')

echo
echo -e "${PURPLE}${BOLD}── FilzaOS System Overview ──────────────────────────${RESET}"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "OS" "FilzaOS Linux Remix"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Version" "1.0.9"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Base" "Ubuntu 24.04.5 LTS"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Codename" "Noble"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Kernel" "$KERNEL"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Architecture" "$ARCH"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Desktop" "$DESKTOP"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Shell" "$SHELL_NAME"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Hostname" "$HOST"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "CPU" "$CPU"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "GPU" "$GPU"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "RAM" "$MEM_USED / $MEM_TOTAL"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Root Disk" "$DISK_USED / $DISK_TOTAL ($DISK_PERCENT)"
printf "  ${LAVENDER}%-14s${RESET} : %s\n" "Uptime" "$UPTIME"
echo -e "${PURPLE}─────────────────────────────────────────────────────${RESET}"
echo
