#!/usr/bin/env bash
# ============================================================
# FILZAOS DESKTOP INITIALIZATION
# ============================================================

LOG="$HOME/.filzaos-startup.log"

{
    echo "========================================"
    echo "          FILZAOS DESKTOP STARTUP"
    echo "$(date)"
    echo "========================================"

    export FILZAOS=1
    export FILZAOS_VERSION="1.0.8"

    # Set hostname safely
    sudo hostnamectl set-hostname filzaos 2>/dev/null || true
    sudo hostname filzaos 2>/dev/null || true

    # Wait until GNOME settings daemon is ready (fail-fast up to 20s)
    for i in {1..40}; do
        if gsettings writable org.gnome.desktop.interface icon-theme >/dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done

    # 1. Wallpaper
    WALLPAPER="file:///usr/share/backgrounds/filzaos/filzaos.png"
    gsettings set org.gnome.desktop.background picture-uri "$WALLPAPER" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-uri-dark "$WALLPAPER" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-options "zoom" 2>/dev/null || true
    gsettings set org.gnome.desktop.background primary-color "#0B0614" 2>/dev/null || true
    gsettings set org.gnome.desktop.background secondary-color "#0B0614" 2>/dev/null || true

    # 2. Appearance & Themes
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "FilzaOS" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "FilzaOS" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme "Yaru" 2>/dev/null || true

    # 3. Dock & Favorites (clean pinned apps: Files, Terminal, Firefox)
    gsettings set org.gnome.shell favorite-apps "['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox_firefox.desktop']" 2>/dev/null || true

    # 4. Terminal profile purple styling
    SCHEMA="org.gnome.Terminal.ProfilesList"
    if gsettings list-keys "$SCHEMA" >/dev/null 2>&1; then
        PROFILE=$(gsettings get "$SCHEMA" default 2>/dev/null | tr -d "'")
        if [[ -z "$PROFILE" || "$PROFILE" == "none" ]]; then
            PROFILE=$(gsettings get "$SCHEMA" list 2>/dev/null | grep -oE "'[a-f0-9-]{36}'" | head -1 | tr -d "'")
        fi
        if [[ -n "$PROFILE" ]]; then
            BASE="org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:$PROFILE/"
            gsettings set "$BASE" use-theme-colors false 2>/dev/null || true
            gsettings set "$BASE" background-color '#0B0614' 2>/dev/null || true
            gsettings set "$BASE" foreground-color '#E9D5FF' 2>/dev/null || true
            gsettings set "$BASE" bold-color '#C084FC' 2>/dev/null || true
            gsettings set "$BASE" cursor-background-color '#C084FC' 2>/dev/null || true
            gsettings set "$BASE" cursor-foreground-color '#0B0614' 2>/dev/null || true
            gsettings set "$BASE" palette "['#0B0614', '#FF5555', '#50FA7B', '#F1FA8C', '#BD93F9', '#FF79C6', '#8BE9FD', '#F8F8F2', '#44475A', '#FF6E6E', '#69FF94', '#FFFFA5', '#D6ACFF', '#FF92DF', '#A4FFFF', '#FFFFFF']" 2>/dev/null || true
        fi
    fi

    # 5. Terminal prompt in ~/.bashrc
    PROMPT_LINE='PS1="\[\e[38;5;141m\]┌──[filzaos@filzaos]─[\w]\n\[\e[38;5;93m\]└─$ \[\e[0m\]"'
    if [[ -f "$HOME/.bashrc" ]] && ! grep -q "filzaos@filzaos" "$HOME/.bashrc"; then
        echo "$PROMPT_LINE" >> "$HOME/.bashrc"
    fi

    # 6. Remove installer shortcuts from desktop
    for DIR in "$HOME/Desktop" "$HOME/desktop" "/home/ubuntu/Desktop" "/home/ubuntu/desktop"; do
        if [[ -d "$DIR" ]]; then
            find "$DIR" -maxdepth 1 -type f -name '*.desktop' | while read -r f; do
                if grep -Eiq 'Install Ubuntu|Ubuntu.*24\.04|ubiquity|ubuntu-desktop-installer|install-ubuntu|bootstrap' "$f" 2>/dev/null; then
                    rm -f "$f" 2>/dev/null || true
                fi
            done
        fi
    done

    # 7. Remove installer desktop files from applications directories
    sudo rm -f \
        /usr/share/applications/ubiquity.desktop \
        /usr/share/applications/ubuntu-desktop-installer.desktop \
        /usr/share/applications/install-ubuntu.desktop \
        /var/lib/snapd/desktop/applications/ubuntu-desktop-bootstrap*.desktop \
        2>/dev/null || true

    echo "FilzaOS startup completed successfully."
    echo "Hostname: $(hostname)"
    echo "Icon Theme: $(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null)"
    echo "GTK Theme: $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)"
    echo "Wallpaper: $(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null)"
} >> "$LOG" 2>&1

exit 0
