[org/gnome/desktop/interface]
color-scheme='prefer-dark'
icon-theme='FilzaOS'
gtk-theme='FilzaOS'
accent-color='purple'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/filzaos/filzaos.png'
picture-uri-dark='file:///usr/share/backgrounds/filzaos/filzaos.png'
picture-options='zoom'

[org/gnome/shell]
enabled-extensions=['ding@rastersoft.com']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='LEFT'
extend-height=false
dash-max-icon-size=48
background-opacity=0.85
background-color='#0B0614'
customize-always-center-icons=true

[org/gnome/shell/extensions/ding]
icon-size='standard'
show-home=false
show-trash=true
show-volumes=true
show-network-volumes=true
